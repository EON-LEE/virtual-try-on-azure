# No inference occurs until the operator has explicit account and cost approval.
ENABLE_AZURE_INFERENCE=false
# Zero allowance closes every paid job, even with ENABLE_AZURE_INFERENCE=true.
# Counts selected models, including failed attempts. Reset on server restart.
DEMO_MAX_MODEL_ATTEMPTS=0
DEMO_INFERENCE_EXPIRES_AT=
HOST=127.0.0.1
PORT=3000
# Required when HOST is not loopback. Set a long random secret, never commit it.
APP_ACCESS_TOKEN=
# Separate operator-only credential; never give this to invited demo users.
DEMO_OPERATOR_TOKEN=
# Required behind a public HTTPS reverse proxy, e.g. https://studio.example.com
APP_ORIGIN=
# The provisioned resources disable API-key auth. Use entra-cli only after
# explicit identity configuration below; keeping inference false acquires no token.
AZURE_AUTH_MODE=entra-cli
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_EXPECTED_PRINCIPAL_ID=
# Hosted explicit managed-identity mode additionally needs this user-assigned ID.
AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Provisioned eastus2 / gpt-image-2.5-sunburst 2026-09-08; data-plane unverified.
AZURE_SUNBURST_ENDPOINT=https://vto-sunburst-eus2-b0af194e.openai.azure.com
AZURE_SUNBURST_DEPLOYMENT=tryon-sunburst
AZURE_SUNBURST_API_KEY=
AZURE_SUNBURST_API_VERSION=2025-04-01-preview
# Provisioned eastus / MAI-Image-2.6 2026-07-31; data-plane unverified.
AZURE_MAI_ENDPOINT=https://vto-mai26-eus-b0af194e.services.ai.azure.com
AZURE_MAI_DEPLOYMENT=tryon-mai26
AZURE_MAI_API_KEY=
# User-selected basic MAI Image 2.6 (Preview); Flash is excluded.
AZURE_MAI_MODEL=MAI-Image-2.6
